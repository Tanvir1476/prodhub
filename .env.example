# ──────────────────────────────────────────────────────────────────────────────
# ProdHub — environment variables
# Copy this file to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables for deployment.
# ──────────────────────────────────────────────────────────────────────────────

# Supabase → Project Settings → API
# Safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Bypasses Row Level Security. Used exclusively on the server to
# insert visitor submissions/requests after validation and to upload images.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The one and only Admin account (must match the Supabase Auth user you create
# and register with supabase/admin.sql).
ADMIN_EMAIL=admin@example.com

# Public URL of the site (used for metadata / Open Graph). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash client IPs for rate limiting. Optional but recommended.
RATE_LIMIT_SALT=change-me-to-a-long-random-string
